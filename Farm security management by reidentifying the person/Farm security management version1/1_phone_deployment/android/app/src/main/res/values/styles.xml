<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the Flutter UI initializes -->
    <style name="LaunchTheme" parent="NormalTheme">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme to apply after the launch screen is dismissed and Flutter is active -->
    <style name="NormalTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
